# TZJ 生产网关：按域名反代到 compose 内部服务
# nginx 官方镜像启动时对 templates/*.template 执行 envsubst（见 NGINX_ENVSUBST_FILTER）

server {
    listen 80 default_server;
    server_name _;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${WEB_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;

    location / {
        include /etc/nginx/snippets/proxy-docker.conf;
        set $upstream_web web:3000;
        proxy_pass http://$upstream_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl http2;
    server_name ${ADMIN_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;

    location / {
        include /etc/nginx/snippets/proxy-docker.conf;
        set $upstream_admin admin:3000;
        proxy_pass http://$upstream_admin;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl http2;
    server_name ${API_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;

    client_max_body_size 100m;

    location / {
        include /etc/nginx/snippets/proxy-docker.conf;
        set $upstream_api api:4000;
        proxy_pass http://$upstream_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# 静态资源：全部代理到 OSS（去除 force-download header，使图片可内联显示）
server {
    listen 443 ssl http2;
    server_name ${STATIC_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;

    location / {
        resolver 127.0.0.11 valid=30s;
        proxy_pass https://${OSS_DOMAIN}$uri;
        proxy_ssl_server_name on;
        proxy_hide_header Content-Disposition;
        proxy_hide_header x-oss-force-download;
        proxy_hide_header x-oss-request-id;
        proxy_hide_header x-oss-object-type;
        proxy_hide_header x-oss-hash-crc64ecma;
        proxy_hide_header x-oss-storage-class;
        proxy_hide_header x-oss-ec;
        proxy_hide_header x-oss-server-time;
        proxy_hide_header Content-MD5;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        add_header Access-Control-Allow-Origin "*";
    }
}
