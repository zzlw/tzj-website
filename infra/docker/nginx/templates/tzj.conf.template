# TZJ 生产网关：按域名反代到 compose 内部服务
# nginx 官方镜像启动时对 templates/*.template 执行 envsubst（见 NGINX_ENVSUBST_FILTER）

# WebSocket 升级映射：socket.io（/chat 命名空间，坐席/访客实时聊天）走 ws，
# 依赖 Upgrade/Connection 头透传。NGINX_ENVSUBST_FILTER=DOMAIN 不会替换这些 nginx 变量。
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# 投放落地 HTML：按路径缓存、忽略 query（utm_* / bd_vid 每次点击都不同）。
# RSC / Next prefetch 请求带专用头，必须跳过，避免把飞行数据当成文档缓存。
map $http_rsc $web_html_bypass_rsc {
    default 0;
    "~."    1;
}
map $http_next_router_prefetch $web_html_bypass_prefetch {
    default 0;
    "~."    1;
}

proxy_cache_path /var/cache/nginx/web_html levels=1:2 keys_zone=web_html:16m max_size=128m inactive=10m use_temp_path=off;

server {
    listen 80 default_server;
    server_name _;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${WEB_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;

    # ── 百度站长平台文件校验 ──────────────────────────────────────
    # 站点归属校验：根 / 会 308→/zh-CN、任意 *.html 会被下方兜底 301，百度校验器
    # 不跟随跳转，取不到 200 即报「无法连接到您网站的服务器」。exact-match location
    # 优先级高于正则，故此处直出 200 + 校验串（内容取自站长平台下载的校验文件）。
    location = /baidu_verify_codeva-uyyRhMh9Qw.html {
        default_type text/html;
        return 200 "1ceccbb19f78dde15b5c116f24ff3590";
    }

    # ── 老站（静态 PHP 站）URL 301 承接 ─────────────────────────────
    # 百度老创意/历史收录指向 proshow-*.html 等路径，新站（Next.js）无此路径会 404。
    # 按“URL 模式 → 新站栏目页”粗映射（映射依据见 docs/baidu-sem-migration-guide.md 第二节）。
    # 正则 location 优先级高于前缀 location /，且按书写顺序匹配；具体模式在前、兜底在后。
    # $is_args$args：保留老创意可能携带的 ?bd_vid=...&utm_* 参数，避免转化追踪丢失。
    location ~* ^/proshow-.*\.html$   { return 301 https://$host/zh-CN/towers$is_args$args; }
    location ~* ^/prolist-.*\.html$   { return 301 https://$host/zh-CN/towers$is_args$args; }
    location ~* ^/caseshow-.*\.html$  { return 301 https://$host/zh-CN/cases$is_args$args; }
    location ~* ^/caselist-.*\.html$  { return 301 https://$host/zh-CN/cases$is_args$args; }
    location ~* ^/newsshow-.*\.html$  { return 301 https://$host/zh-CN/resources/news$is_args$args; }
    location ~* ^/newslist-.*\.html$  { return 301 https://$host/zh-CN/resources/news$is_args$args; }
    location ~* ^/page-.*\.html$      { return 301 https://$host/zh-CN/why-us$is_args$args; }
    location = /index.html            { return 301 https://$host/zh-CN$is_args$args; }
    # 老子目录：article≈资讯、project≈案例
    location ~* ^/article(/|$)         { return 301 https://$host/zh-CN/resources/news$is_args$args; }
    location ~* ^/project(/|$)         { return 301 https://$host/zh-CN/cases$is_args$args; }
    # 兜底：任何其它未匹配的 .html → 首页（新站不供应任何 .html，故可安全兜底）
    location ~* \.html$               { return 301 https://$host/zh-CN$is_args$args; }

    include /etc/nginx/snippets/gzip.conf;

    # 百度推广主力落地：同源站 60s，缓存键不含 query，付费点击共用一条 HTML。
    location ~* ^/(zh-CN|zh-TW|en)/(fixed-tower|specialized-training|accessories|towers)(/|$) {
        include /etc/nginx/snippets/proxy-web.conf;
        proxy_cache web_html;
        proxy_cache_key $scheme$host$uri;
        proxy_cache_valid 200 60s;
        proxy_cache_lock on;
        proxy_cache_use_stale updating error timeout http_500 http_502;
        proxy_ignore_headers Cache-Control Set-Cookie Vary;
        proxy_hide_header Set-Cookie;
        proxy_cache_bypass $web_html_bypass_rsc $web_html_bypass_prefetch;
        proxy_no_cache $web_html_bypass_rsc $web_html_bypass_prefetch;
        add_header X-Web-Cache $upstream_cache_status;
    }

    location / {
        include /etc/nginx/snippets/proxy-web.conf;
    }
}

server {
    listen 443 ssl http2;
    server_name ${ADMIN_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;
    include /etc/nginx/snippets/gzip.conf;

    # Admin 上传媒体/富文本附件：与 API 侧 Multer 100MB 上限对齐
    client_max_body_size 100m;

    location / {
        include /etc/nginx/snippets/proxy-docker.conf;
        set $upstream_admin admin:3000;
        proxy_pass http://$upstream_admin;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 灵犀 SSE 长连接：默认 60s 会断流，放宽到 300s（缓冲由 X-Accel-Buffering: no 响应头关闭）
        proxy_read_timeout 300s;
    }
}

server {
    listen 443 ssl http2;
    server_name ${API_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;
    include /etc/nginx/snippets/gzip.conf;

    client_max_body_size 100m;

    # Turbo 远端缓存（构建加速）：/v8/* 由 turbo-cache 服务处理，
    # 前缀 /turbo-cache/ 剥离后转发（Turbo client 的 TURBO_API=https://api.tzjii.com/turbo-cache）
    location /turbo-cache/ {
        include /etc/nginx/snippets/proxy-docker.conf;
        set $upstream_turbo_cache turbo-cache:3000;
        rewrite ^/turbo-cache/(.*)$ /$1 break;
        proxy_pass http://$upstream_turbo_cache;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        include /etc/nginx/snippets/proxy-docker.conf;
        set $upstream_api api:4000;
        proxy_pass http://$upstream_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# 裸域 301 → www（泛域证书覆盖 tzjii.com + *.tzjii.com）
# `/` 直接落到默认语言首页，避免「apex→www」后再被 Next 308 补 `/zh-CN` 的两跳。
# 带路径的请求（含 /zh-CN、/en）只补 www，不改写 locale。
server {
    listen 80;
    server_name ${BASE_DOMAIN};

    location = / {
        return 301 https://www.${BASE_DOMAIN}/zh-CN$is_args$args;
    }
    location / {
        return 301 https://www.${BASE_DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${BASE_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;

    location = / {
        return 301 https://www.${BASE_DOMAIN}/zh-CN$is_args$args;
    }
    location / {
        return 301 https://www.${BASE_DOMAIN}$request_uri;
    }
}
