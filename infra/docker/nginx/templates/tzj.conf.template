# TZJ 生产网关：按域名反代到 compose 内部服务
# nginx 官方镜像启动时对 templates/*.template 执行 envsubst（见 NGINX_ENVSUBST_FILTER）

# WebSocket 升级映射：socket.io（/chat 命名空间，坐席/访客实时聊天）走 ws，
# 依赖 Upgrade/Connection 头透传。NGINX_ENVSUBST_FILTER=DOMAIN 不会替换这些 nginx 变量。
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80 default_server;
    server_name _;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${WEB_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;

    # ── 老站（静态 PHP 站）URL 301 承接 ─────────────────────────────
    # 百度老创意/历史收录指向 proshow-*.html 等路径，新站（Next.js）无此路径会 404。
    # 按“URL 模式 → 新站栏目页”粗映射（映射依据见 docs/baidu-sem-migration-guide.md 第二节）。
    # 正则 location 优先级高于前缀 location /，且按书写顺序匹配；具体模式在前、兜底在后。
    # $is_args$args：保留老创意可能携带的 ?bd_vid=...&utm_* 参数，避免转化追踪丢失。
    location ~* ^/proshow-.*\.html$   { return 301 https://$host/zh-CN/towers$is_args$args; }
    location ~* ^/prolist-.*\.html$   { return 301 https://$host/zh-CN/towers$is_args$args; }
    location ~* ^/caseshow-.*\.html$  { return 301 https://$host/zh-CN/cases$is_args$args; }
    location ~* ^/caselist-.*\.html$  { return 301 https://$host/zh-CN/cases$is_args$args; }
    location ~* ^/newsshow-.*\.html$  { return 301 https://$host/zh-CN/resources/news$is_args$args; }
    location ~* ^/newslist-.*\.html$  { return 301 https://$host/zh-CN/resources/news$is_args$args; }
    location ~* ^/page-.*\.html$      { return 301 https://$host/zh-CN/why-us$is_args$args; }
    location = /index.html            { return 301 https://$host/zh-CN$is_args$args; }
    # 老子目录：article≈资讯、project≈案例
    location ~* ^/article(/|$)         { return 301 https://$host/zh-CN/resources/news$is_args$args; }
    location ~* ^/project(/|$)         { return 301 https://$host/zh-CN/cases$is_args$args; }
    # 兜底：任何其它未匹配的 .html → 首页（新站不供应任何 .html，故可安全兜底）
    location ~* \.html$               { return 301 https://$host/zh-CN$is_args$args; }

    location / {
        include /etc/nginx/snippets/proxy-docker.conf;
        set $upstream_web web:3000;
        proxy_pass http://$upstream_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl http2;
    server_name ${ADMIN_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;

    location / {
        include /etc/nginx/snippets/proxy-docker.conf;
        set $upstream_admin admin:3000;
        proxy_pass http://$upstream_admin;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 灵犀 SSE 长连接：默认 60s 会断流，放宽到 300s（缓冲由 X-Accel-Buffering: no 响应头关闭）
        proxy_read_timeout 300s;
    }
}

server {
    listen 443 ssl http2;
    server_name ${API_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;

    client_max_body_size 100m;

    location / {
        include /etc/nginx/snippets/proxy-docker.conf;
        set $upstream_api api:4000;
        proxy_pass http://$upstream_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# 静态资源：反代 compose 内网 MinIO（path-style：/bucket/key）
# 预签名直传依赖 Host 不被改写（SigV4 把 Host 算进签名），proxy_set_header Host 不可省
server {
    listen 443 ssl http2;
    server_name ${STATIC_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;

    client_max_body_size 100m;          # 预签名 PUT 直传上限

    location / {
        include /etc/nginx/snippets/proxy-docker.conf;
        set $upstream_minio minio:9000;
        proxy_pass http://$upstream_minio;
        proxy_http_version 1.1;
        proxy_set_header Host $host;    # 关键：保留 Host，SigV4 签名才能校验通过
        proxy_set_header X-Real-IP $remote_addr;
        # 大文件上传（后台媒体上传 / 迁移同步）：不能关 proxy_request_buffering！MinIO SigV4
        # 用 aws-chunked 流式签名，body 帧与 Content-Length 必须原样透传；关缓冲会让 nginx 改
        # 用 chunked 重编码转发，破坏签名导致 minio 返 400。保留默认缓冲（原样保留 body），
        # 仅放宽读写/请求体超时到 300s，覆盖低带宽下 ~100MB 单次 PUT 的缓冲耗时。
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        client_body_timeout 300s;
        # 公开读的静态资源缓存（MinIO 返回的私有请求不受影响）
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
    }
}

# 裸域 301 → www（泛域证书覆盖 tzjii.com + *.tzjii.com）
server {
    listen 443 ssl http2;
    server_name ${BASE_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;
    return 301 https://www.${BASE_DOMAIN}$request_uri;
}
