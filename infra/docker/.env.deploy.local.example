# 复制为 infra/docker/.env.deploy.local（已 gitignore，勿提交）
# 用法: ./infra/docker/deploy-local.sh

# ── ACR（控制台 → 访问凭证）────────────────────────────────
ACR_REGISTRY=REDACTED-ACR
ACR_NAMESPACE=REDACTED-NAMESPACE
ACR_USERNAME=your-acr-username
ACR_PASSWORD=your-acr-fixed-password

# ── ECS SSH ────────────────────────────────────────────────
ECS_HOST=REDACTED-IP
ECS_USER=root
# 默认用 ~/.ssh/id_rsa；若用其他密钥请填写绝对路径
# ECS_SSH_KEY=~/.ssh/id_rsa

# ── 镜像 tag（默认 git short sha）──────────────────────────
# IMAGE_TAG=local-manual

# ── Next.js build-args（一般不用改）────────────────────────
NEXT_PUBLIC_API_URL=https://tzj-api.jiawen.live/api/v1
NEXT_PUBLIC_ADMIN_API_URL=https://tzj-api.jiawen.live/api/v1
NEXT_PUBLIC_S3_PUBLIC_DOMAIN=https://tzj-static.jiawen.live
NEXT_PUBLIC_SITE_URL=https://tzj.jiawen.live
NEXT_PUBLIC_WEB_URL=https://tzj.jiawen.live
