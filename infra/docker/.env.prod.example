# 复制为 /opt/tzj/.env.prod（非敏感 + api 运行时变量）
# 密钥、ACR tag、阿里云 DNS 见 .env.prod.local
IMAGE_REGISTRY=REDACTED-ACR/REDACTED-NAMESPACE

# 网关 / ACME（compose gateway + acme 服务）
WEB_DOMAIN=tzj.jiawen.live
ADMIN_DOMAIN=tzj-admin.jiawen.live
API_DOMAIN=tzj-api.jiawen.live
BASE_DOMAIN=jiawen.live
STATIC_DOMAIN=tzj-static.jiawen.live
ACME_EMAIL=admin@jiawen.live

POSTGRES_USER=tzj
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tzj_prod

DATABASE_URL=postgresql://tzj:change-me@postgres:5432/tzj_prod?schema=public

API_PORT=4000
NODE_ENV=production
JWT_SECRET=change-me-min-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
SECRETS_ENCRYPTION_KEY=change-me-min-32-characters-long!!
CORS_ORIGINS=https://tzj.jiawen.live,https://tzj-admin.jiawen.live
THROTTLE_TTL=60
THROTTLE_LIMIT=120

WEB_URL=https://tzj.jiawen.live
ADMIN_URL=https://tzj-admin.jiawen.live
NEXT_PUBLIC_WEB_URL=https://tzj.jiawen.live
NEXT_PUBLIC_SITE_URL=https://tzj.jiawen.live
NEXT_PUBLIC_API_URL=https://tzj-api.jiawen.live/api/v1
NEXT_PUBLIC_ADMIN_API_URL=https://tzj-api.jiawen.live/api/v1

S3_BUCKET=tzj-media-static-assets
S3_REGION=oss-cn-beijing
S3_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
S3_ACCESS_KEY_ID=
S3_ACCESS_KEY_SECRET=
S3_PUBLIC_DOMAIN=https://tzj-static.jiawen.live
NEXT_PUBLIC_S3_PUBLIC_DOMAIN=https://tzj-static.jiawen.live

ANALYTICS_IP_SALT=tzj-analytics-prod
