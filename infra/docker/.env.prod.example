# 复制为 /opt/tzj/.env.prod（非敏感 + api 运行时变量）
# 密钥、ACR tag、阿里云 DNS 见 .env.prod.local
# ⚠️ IMAGE_REGISTRY 必须等于 GitHub Vars 的 ACR_REGISTRY/ACR_NAMESPACE 拼接值，两边不一致会 pull 错/拉不到镜像
IMAGE_REGISTRY=REDACTED-ACR/<ACR_NAMESPACE>

# 网关 / ACME（compose gateway + acme 服务）
WEB_DOMAIN=www.tzjii.com
ADMIN_DOMAIN=admin.tzjii.com
API_DOMAIN=api.tzjii.com
BASE_DOMAIN=tzjii.com
ACME_EMAIL=admin@tzjii.com

POSTGRES_USER=tzj
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tzj_prod

DATABASE_URL=postgresql://tzj:change-me@postgres:5432/tzj_prod?schema=public

API_PORT=4000
NODE_ENV=production
JWT_SECRET=change-me-min-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
SECRETS_ENCRYPTION_KEY=change-me-min-32-characters-long!!
CORS_ORIGINS=https://www.tzjii.com,https://admin.tzjii.com
THROTTLE_TTL=60
THROTTLE_LIMIT=120

WEB_URL=https://www.tzjii.com
ADMIN_URL=https://admin.tzjii.com
NEXT_PUBLIC_WEB_URL=https://www.tzjii.com
NEXT_PUBLIC_SITE_URL=https://www.tzjii.com
NEXT_PUBLIC_API_URL=https://api.tzjii.com/api/v1
NEXT_PUBLIC_ADMIN_API_URL=https://api.tzjii.com/api/v1

# S3 段：阿里云 OSS（生产，virtual-hosted style），AK/SK 用 RAM 用户（服务器端脚本存 .env.prod.local）
S3_BUCKET=tzj-prod-media
S3_REGION=oss-cn-beijing
S3_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
S3_ACCESS_KEY_ID=
S3_ACCESS_KEY_SECRET=
S3_PUBLIC_DOMAIN=https://static.tzjii.com
NEXT_PUBLIC_S3_PUBLIC_DOMAIN=https://static.tzjii.com
S3_FORCE_PATH_STYLE=false

# Turbo 远端缓存（构建加速）：自建服务存储在 OSS 私有桶，OSS 生命周期 7 天自动过期
TURBO_CACHE_BUCKET=tzj-turbo-cache

ANALYTICS_IP_SALT=tzj-analytics-prod
