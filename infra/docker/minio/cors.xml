<?xml version="1.0" encoding="UTF-8"?>
<!--
  S3 / MinIO / 阿里云 OSS 通用 CORS 配置（S3 CORS XML 格式）
  用途：允许浏览器用「预签名 PUT URL」直传聊天附件，以及公开 GET 读取。
  通过 `mc cors set <alias>/<bucket> cors.xml` 应用到 bucket（MinIO / OSS 均兼容 S3 CORS API）。
  注意：本地开发改用 minio 服务的 MINIO_API_CORS_ALLOW_* 环境变量（全局，启动即生效），
        本文件只用于生产 OSS（bash infra/docker/oss/apply-cors.sh）。

  允许的源：
    - 本地开发：web(3001) / admin(3002) / 历史端口 3000
    - 生产：www.tzjii.com（web） / admin.tzjii.com（admin）
  允许的方法：GET(PUT 后读取) / PUT(预签名直传) / POST / HEAD
-->
<CORSConfiguration>
  <CORSRule>
    <AllowedOrigin>http://localhost:3000</AllowedOrigin>
    <AllowedOrigin>http://localhost:3001</AllowedOrigin>
    <AllowedOrigin>http://localhost:3002</AllowedOrigin>
    <AllowedOrigin>https://www.tzjii.com</AllowedOrigin>
    <AllowedOrigin>https://admin.tzjii.com</AllowedOrigin>
    <AllowedMethod>GET</AllowedMethod>
    <AllowedMethod>PUT</AllowedMethod>
    <AllowedMethod>POST</AllowedMethod>
    <AllowedMethod>HEAD</AllowedMethod>
    <AllowedHeader>*</AllowedHeader>
    <ExposeHeader>ETag</ExposeHeader>
    <ExposeHeader>x-amz-request-id</ExposeHeader>
    <ExposeHeader>x-oss-request-id</ExposeHeader>
    <MaxAgeSeconds>3000</MaxAgeSeconds>
  </CORSRule>
</CORSConfiguration>
