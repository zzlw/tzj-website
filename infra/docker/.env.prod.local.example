# 复制为 /opt/tzj/.env.prod.local（gitignore，勿提交）
# deploy.sh 会在每次部署时更新 *_TAG；首次部署前填 latest 或与 CI 一致的 commit id

IMAGE_TAG=latest
API_TAG=latest
WEB_TAG=latest
ADMIN_TAG=latest

# 可选：将 .env.prod 中的密钥迁移到此文件（与 REDACTED-NAMESPACE 一致的分层）
# 若迁移密钥，请确保 DATABASE_URL 等与 POSTGRES_PASSWORD 一致
# JWT_SECRET=
# POSTGRES_PASSWORD=
