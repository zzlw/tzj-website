# 复制为 /opt/tzj/.env.prod.local（gitignore，勿提交）
# deploy.sh 会在每次部署时更新 *_TAG；首次部署前填 latest 或与 CI 一致的 commit id

IMAGE_TAG=latest
API_TAG=latest
WEB_TAG=latest
ADMIN_TAG=latest

# 可选：ACME 证书（与 REDACTED-NAMESPACE-deploy 相同流程）
# Cloudflare NS → CF_API_TOKEN + CF_ZONE_ID
# 阿里云 NS  → ALI_KEY + ALI_SECRET
# CDN 证书推送仍需 ALI_KEY/ALI_SECRET
# CF_API_TOKEN=
# CF_ZONE_ID=
# ALI_KEY=
# ALI_SECRET=
