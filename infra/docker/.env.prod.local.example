# 复制为 /opt/tzj/.env.prod.local（gitignore，勿提交）
# deploy.sh 会在每次部署时更新 *_TAG；首次部署前填 latest 或与 CI 一致的 commit id

IMAGE_TAG=latest
API_TAG=latest
WEB_TAG=latest
ADMIN_TAG=latest

# 双轨 CSS 灰度：=1 时旧内核（不支持 oklch/color-mix）自动加载 legacy.css；留空/0 关闭（可运行时覆盖，回滚即置空）
LEGACY_CSS_ENABLED=
LEGACY_CSS_PERCENT=100

# ACME 证书 DNS-01 凭证 + deploy.sh CDN 静态资源同步（OSS）凭证
# （tzjii.com NS 在阿里云 → 只填 ALI_KEY/ALI_SECRET；两者缺一不可）
# ⚠️ CF_API_TOKEN/CF_ZONE_ID 必须留空：issue.sh 判定 CF 凭证优先于阿里云，残留会导致签发必败
# CF_API_TOKEN=
# CF_ZONE_ID=
# ALI_KEY=
# ALI_SECRET=

# Turbo 远端缓存访问令牌（自建服务鉴权；与 GitHub Actions secret TURBO_TOKEN 保持一致）
# 生成：openssl rand -hex 32
TURBO_CACHE_TOKEN=change-me

# 部署时每服务保留的镜像版本数（更旧镜像自动清理，防止磁盘打满）
KEEP_IMAGE_VERSIONS=3
