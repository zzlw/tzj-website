# ============================================================
# TZJ Monorepo — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# Validated at runtime via @tzj/config/env (Zod schemas).

# ── Database (PostgreSQL 15) ──────────────────────────────────
DATABASE_URL="postgresql://tzj_admin:tzj_secret_dev@localhost:5432/tzj_dev?schema=public"

# ── Redis 7 ───────────────────────────────────────────────────
REDIS_URL=

# ── API (NestJS 11) ───────────────────────────────────────────
API_PORT=4000
NODE_ENV="development"
JWT_SECRET="replace-me-with-a-secure-random-string-at-least-16-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
# CORS 白名单（逗号分隔）: web(3001) / admin(3002)
CORS_ORIGINS="http://localhost:3001,http://localhost:3002"
# 限流：THROTTLE_TTL 秒内最多 THROTTLE_LIMIT 次
THROTTLE_TTL=60
THROTTLE_LIMIT=120
# GPS 逆地理：高德 Web 服务 Key（https://console.amap.com/dev/key/app）
# 推荐在后台「集成与凭证」维护；此处为 env 兜底
AMAP_WEB_KEY=""
# 第三方凭证 DB 加密主密钥（至少 32 字符，生产务必配置）
SECRETS_ENCRYPTION_KEY=""
# 阿里云验证码 2.0（推荐在后台「集成与凭证」维护；此处为 env 兜底）
ALIYUN_CAPTCHA_ACCESS_KEY_ID=""
ALIYUN_CAPTCHA_ACCESS_KEY_SECRET=""
NEXT_PUBLIC_ALIYUN_CAPTCHA_PREFIX=""
NEXT_PUBLIC_ALIYUN_CAPTCHA_SCENE_ID=""
ALIYUN_CAPTCHA_REGION="cn"
# 阿里企业邮箱 SMTP（推荐在后台「集成与凭证」维护；此处为 env 兜底）
# smtpPassword 为发件账号在个人邮箱「三方客户端安全管理」中生成的安全密码，非登录密码
ALIYUN_EXMAIL_SMTP_PASSWORD=""
ALIYUN_EXMAIL_ACCOUNT_NAME="service@tzjii.com"
ALIYUN_EXMAIL_FROM_ALIAS="拓之迹官网"
# 访客 IP 哈希盐（可选，默认内置值）
ANALYTICS_IP_SALT="tzj-analytics-default"
# 灵犀 AI（LLM）— 默认 DeepSeek 官方；推荐在后台「集成与凭证」维护，此处为 env 兜底
LINGXI_LLM_BASE_URL="https://api.deepseek.com"
LINGXI_LLM_API_KEY=""
LINGXI_LLM_MODEL="deepseek-v4-flash"
# 百度 OCPC 转化回传（推荐在后台「集成与凭证」维护，此处为 env 兜底；三项齐全才回传）
# TOKEN：百度营销后台「转化追踪 → API 接入」获取的回传 Token
# CONVERT_TYPE：转化类型编码（newType，如 3=表单提交成功、18=留线索），由后台新建转化追踪时按官方转化编码表确定
# SITE_URL：落地页域名前缀，用于拼接携带 bd_vid 的 logidUrl
BAIDU_OCPC_TOKEN=""
BAIDU_OCPC_CONVERT_TYPE=""
BAIDU_OCPC_SITE_URL=""

# ── Web (Next.js 16) ──────────────────────────────────────────
WEB_URL="http://localhost:3001"
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_S3_PUBLIC_DOMAIN="http://localhost:9000/tzj-uploads-dev"
NEXT_PUBLIC_CONTACT_PHONE="0371-58691119"
NEXT_PUBLIC_CONTACT_EMAIL="contact@tzjii.com"

# ── Admin (Next.js 16) ────────────────────────────────────────
ADMIN_URL="http://localhost:3002"
NEXT_PUBLIC_ADMIN_API_URL="http://localhost:4000/api/v1"

# ── Storage (MinIO / 阿里云 OSS) ───────────────────────────────
# 本地: MinIO (S3-compatible), 线上: 阿里云 OSS (零代码切换)
# 站点静态资源（图片/视频）统一存 MinIO content/ 前缀；迁移命令见 apps/api prisma:sync:static-media
S3_BUCKET="tzj-uploads-dev"
S3_REGION="us-east-1"
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="minioadmin"
S3_ACCESS_KEY_SECRET="minioadmin"
S3_PUBLIC_DOMAIN="http://localhost:9000/tzj-uploads-dev"
