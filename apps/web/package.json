{
  "name": "@tzj/web",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "chrome 86",
    "safari 14"
  ],
  "scripts": {
    "dev": "node scripts/generate-placeholders.mjs && node -e \"try{require('child_process').execSync('lsof -ti:3001|xargs kill -9',{stdio:'ignore'})}catch{}\" && next dev --port 3001",
    "build": "node scripts/generate-placeholders.mjs && pnpm --filter @tzj/legacy-css build && next build",
    "start": "next start --port 3001",
    "lint": "biome lint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:placeholders": "node scripts/generate-placeholders.mjs",
    "postinstall": "node scripts/copy-vditor-assets.mjs"
  },
  "dependencies": {
    "@tzj/device": "workspace:*",
    "@tzj/env": "workspace:*",
    "@tzj/types": "workspace:*",
    "@tzj/ui": "workspace:*",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "next-intl": "catalog:",
    "next-view-transitions": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "^0.35.2",
    "socket.io-client": "catalog:",
    "tailwind-merge": "catalog:",
    "tw-animate-css": "catalog:",
    "vditor": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "postcss": "catalog:",
    "shadcn": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  }
}
