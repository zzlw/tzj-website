# TZJ Web — 环境变量示例
# 复制为 .env.local 并按需修改

# 站点 URL（SEO / OG / sitemap）
NEXT_PUBLIC_SITE_URL=https://www.tzjii.com

# 后端 API
NEXT_PUBLIC_API_URL=http://localhost:3002/api/v1

# 联系方式（可通过环境变量覆盖 lib/site.ts 默认值）
NEXT_PUBLIC_CONTACT_PHONE=0371-6718-8888
NEXT_PUBLIC_CONTACT_EMAIL=sales@tzjii.com
NEXT_PUBLIC_CONTACT_ADDRESS=河南省郑州市高新技术开发区科学大道

# 备案号
NEXT_PUBLIC_BEIAN=豫ICP备XXXXXXXX号

# Cloudflare Turnstile（可选，未配置则跳过人机验证）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
