# TZJ Web — 环境变量示例
# 复制为 .env.local 并按需修改

# 站点 URL（SEO / OG / sitemap）
NEXT_PUBLIC_SITE_URL=https://www.tzjii.com

# 后端 API
NEXT_PUBLIC_API_URL=http://localhost:3002/api/v1

# 联系方式（可通过环境变量覆盖 lib/site.ts 默认值）
NEXT_PUBLIC_CONTACT_PHONE=0371-6718-8888
NEXT_PUBLIC_CONTACT_EMAIL=contact@tzjii.com
NEXT_PUBLIC_CONTACT_ADDRESS=河南省郑州市高新技术开发区科学大道

# 备案号
NEXT_PUBLIC_BEIAN=豫ICP备XXXXXXXX号

# 百度统计站点 ID（hm.js hash）。兜底用：优先在后台「站点设置 → 访客分析」配置，此处仅作部署级兜底。
# 取自百度统计后台「代码获取」的 hm.js?后缀，用于打通百度关键词级到访/转化报表。留空则不加载。
NEXT_PUBLIC_BAIDU_HM_ID=018d0a41e7842e20b4cfa398f03259e2

# 阿里云验证码 2.0（可选，推荐在后台「集成与凭证」配置）
NEXT_PUBLIC_ALIYUN_CAPTCHA_PREFIX=
NEXT_PUBLIC_ALIYUN_CAPTCHA_SCENE_ID=
