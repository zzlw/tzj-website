// TZJ 应急救援训练装备 — Prisma Schema
// PostgreSQL + Prisma 6

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════
// 工程案例
// ═══════════════════════════════════════════
model Case {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String?  @db.Text
  description String?  @db.Text
  coverImage  String?
  images      String[] @default([])
  location    String?
  client      String?
  caseType    String   // military | fire | police | scenic | school | enterprise
  highlights  String[] @default([])
  specs       Json?
  completionDate DateTime?
  seoTitle    String?
  seoDesc     String?
  sortOrder   Int      @default(0)
  isFeatured  Boolean  @default(false)
  status      String   @default("draft")
  scheduledAt DateTime?
  viewCount   Int      @default(0)
  author      String?
  systemPublishedAt DateTime?
  createdBy         String?
  createdById       String?
  createdByUser     User?    @relation("CaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lastOperator      String?
  lastOperatorId    String?
  lastOperatorUser  User?    @relation("CaseLastOperator", fields: [lastOperatorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([caseType])
  @@index([status])
  @@index([isFeatured])
  @@index([systemPublishedAt])
  @@index([createdById])
  @@index([lastOperatorId])
  @@map("cases")
}

// ═══════════════════════════════════════════
// 新闻资讯
// ═══════════════════════════════════════════
model News {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String?  @db.Text
  content     String?  @db.Text
  coverImage  String?
  images      String[] @default([])
  category    String   // company | industry | knowledge | equipment
  author      String?
  seoTitle    String?
  seoDesc     String?
  isTop       Boolean  @default(false)
  sortOrder   Int      @default(0)
  status      String   @default("draft")
  scheduledAt DateTime?
  viewCount   Int      @default(0)
  publishedAt DateTime?
  systemPublishedAt DateTime?
  createdBy         String?
  createdById       String?
  createdByUser     User?    @relation("NewsCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lastOperator      String?
  lastOperatorId    String?
  lastOperatorUser  User?    @relation("NewsLastOperator", fields: [lastOperatorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([publishedAt])
  @@index([systemPublishedAt])
  @@index([createdById])
  @@index([lastOperatorId])
  @@map("news")
}

// ═══════════════════════════════════════════
// 博客
// ═══════════════════════════════════════════
model Blog {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?  @db.Text
  content     String?  @db.Text
  coverImage  String?
  images      String[] @default([])
  category    String   // training_facility | burn_room | modular | practice | industry
  readTime    String?
  author      String?
  seoTitle    String?
  seoDesc     String?
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  status      String   @default("draft")
  scheduledAt DateTime?
  viewCount   Int      @default(0)
  publishedAt DateTime?
  systemPublishedAt DateTime?
  createdBy         String?
  createdById       String?
  createdByUser     User?    @relation("BlogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lastOperator      String?
  lastOperatorId    String?
  lastOperatorUser  User?    @relation("BlogLastOperator", fields: [lastOperatorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([publishedAt])
  @@index([systemPublishedAt])
  @@index([createdById])
  @@index([lastOperatorId])
  @@map("blogs")
}

// ═══════════════════════════════════════════
// 展会活动
// ═══════════════════════════════════════════
model TradeShow {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  summary        String?   @db.Text
  content        String?   @db.Text
  location       String?
  eventDateLabel String?
  startDate      DateTime?
  endDate        DateTime?
  boothNumber    String?
  eventType      String    @default("exhibition") // exhibition | seminar | roadshow
  coverImage     String?
  images         String[]  @default([])
  externalUrl    String?
  seoTitle       String?
  seoDesc        String?
  sortOrder      Int       @default(0)
  isFeatured     Boolean   @default(false)
  status         String    @default("draft")
  scheduledAt    DateTime?
  viewCount      Int       @default(0)
  publishedAt    DateTime?
  author         String?
  systemPublishedAt DateTime?
  createdBy         String?
  createdById       String?
  createdByUser     User?    @relation("TradeShowCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lastOperator      String?
  lastOperatorId    String?
  lastOperatorUser  User?    @relation("TradeShowLastOperator", fields: [lastOperatorId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([eventType])
  @@index([status])
  @@index([startDate])
  @@index([systemPublishedAt])
  @@index([createdById])
  @@index([lastOperatorId])
  @@map("trade_shows")
}

// ═══════════════════════════════════════════
// 联系信息
// ═══════════════════════════════════════════
model Contact {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  company   String?
  subject   String?
  message   String   @db.Text
  source    String?  // website | admin | api
  isRead    Boolean  @default(false)
  isHandled Boolean  @default(false)
  remark    String?  @db.Text
  lastOperator      String?
  lastOperatorId    String?
  lastOperatorUser  User?    @relation("ContactLastOperator", fields: [lastOperatorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead])
  @@index([isHandled])
  @@index([createdAt])
  @@index([lastOperatorId])
  @@map("contacts")
}

// ═══════════════════════════════════════════
// 静态页面（关于我们、服务承诺等）
// ═══════════════════════════════════════════
model Page {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String?  @db.Text
  coverImage String?
  seoTitle  String?
  seoDesc   String?
  status    String   @default("published")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pages")
}

// ═══════════════════════════════════════════
// 用户（管理后台）
// ═══════════════════════════════════════════
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  nickname  String?
  email     String?  @unique
  phone     String?
  avatar    String?
  role      String   @default("editor") // admin | editor | viewer
  isActive  Boolean  @default(true)
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions    Session[]
  auditLogs   AuditLog[]
  mediaAssets MediaAsset[]
  casesLastOperated     Case[]      @relation("CaseLastOperator")
  newsLastOperated      News[]      @relation("NewsLastOperator")
  blogsLastOperated     Blog[]      @relation("BlogLastOperator")
  tradeShowsLastOperated TradeShow[] @relation("TradeShowLastOperator")
  casesCreated          Case[]      @relation("CaseCreatedBy")
  newsCreated           News[]      @relation("NewsCreatedBy")
  blogsCreated          Blog[]      @relation("BlogCreatedBy")
  tradeShowsCreated     TradeShow[] @relation("TradeShowCreatedBy")
  contactsLastOperated  Contact[]   @relation("ContactLastOperator")
  blockedIpsCreated     BlockedIp[] @relation("BlockedIpCreatedBy")
  integrationsUpdated Integration[] @relation("IntegrationUpdatedBy")
  docsCreated           InternalDocument[] @relation("DocCreatedBy")
  docsLastOperated      InternalDocument[] @relation("DocLastOperator")
  docRevisionsEdited    InternalDocumentRevision[] @relation("DocRevisionEditor")
  docFoldersOwned       DocFolder[] @relation("DocFolderOwner")
  personalDocuments     InternalDocument[] @relation("DocPersonalOwner")
  docTagsOwned          DocTag[] @relation("DocTagOwner")
  docTagsCreated        DocTag[] @relation("DocTagCreatedBy")
  docPermissionsGranted DocumentPermission[] @relation("DocPermissionGrantor")
  docPermissionsAsUser  DocumentPermission[] @relation("DocPermissionUser")

  @@map("users")
}

// ═══════════════════════════════════════════
// 角色与权限（RBAC）
// ═══════════════════════════════════════════
model AccessRole {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("access_roles")
}

// ═══════════════════════════════════════════
// 媒体库（图片/视频/文档统一管理）
// ═══════════════════════════════════════════
model MediaAsset {
  id           String    @id @default(cuid())
  key          String    @unique // S3 对象 key
  url          String // 公开访问 URL
  filename     String // 原始文件名
  mimeType     String
  size         Int // 字节
  width        Int?
  height       Int?
  folder       String    @default("uploads")
  alt          String?
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([folder])
  @@index([mimeType])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("media_assets")
}

// ═══════════════════════════════════════════
// 登录会话（refresh token 轮换 / 可撤销）
// ═══════════════════════════════════════════
model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique // refresh token 的 sha256，不存明文
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ═══════════════════════════════════════════
// 审计日志（谁在何时对什么做了什么）
// ═══════════════════════════════════════════
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // login | logout | create | update | delete | publish ...
  resource   String   // product | case | news | user ...
  resourceId String?
  detail     Json?
  ip         String?
  userAgent  String?
  traceId    String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════
// 官网访客分析（PageView 事件）
// ═══════════════════════════════════════════
model PageView {
  id           String   @id @default(cuid())
  sessionId    String
  path         String
  title        String?
  referrer     String?
  referrerHost String?
  userAgent    String?
  ipHash       String?
  ip           String?
  ipMasked     String?
  country      String?
  region       String?
  city         String?
  geoSource    String?
  deviceType   String?
  browser      String?
  os           String?
  isBot        Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([sessionId])
  @@index([referrerHost, createdAt])
  @@index([isBot, createdAt])
  @@index([country, createdAt])
  @@index([ipHash, createdAt])
  @@map("page_views")
}

// ═══════════════════════════════════════════
// 访客 IP 封禁（哈希存储，支持临时封禁）
// ═══════════════════════════════════════════
model BlockedIp {
  id          String    @id @default(cuid())
  ipHash      String    @unique
  ipMasked    String
  reason      String?
  expiresAt   DateTime?
  createdById String?
  createdBy   User?     @relation("BlockedIpCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([expiresAt])
  @@map("blocked_ips")
}

// ═══════════════════════════════════════════
// 内部文档库（仅后台，不对 C 端公开）
// ═══════════════════════════════════════════
model DocFolder {
  id        String      @id @default(cuid())
  ownerId   String?     @map("owner_id")
  owner     User?       @relation("DocFolderOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  parentId  String?     @map("parent_id")
  parent    DocFolder?  @relation("DocFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  DocFolder[] @relation("DocFolderTree")
  name      String
  slug      String
  sortOrder Int         @default(0) @map("sort_order")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  documents InternalDocument[]

  @@unique([ownerId, parentId, slug])
  @@index([sortOrder])
  @@index([ownerId])
  @@map("doc_folders")
}

model InternalDocument {
  id          String     @id @default(cuid())
  ownerId     String?    @map("owner_id")
  owner       User?      @relation("DocPersonalOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  folderId    String?    @map("folder_id")
  folder      DocFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  title       String
  slug        String     @unique
  summary     String?    @db.Text
  content     String?    @db.Text
  status      String     @default("draft")
  tags        String[]   @default([])
  isPinned    Boolean    @default(false) @map("is_pinned")
  viewCount   Int        @default(0) @map("view_count")
  publishedAt DateTime?  @map("published_at")
  createdBy         String?  @map("created_by")
  createdById       String?  @map("created_by_id")
  createdByUser     User?    @relation("DocCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lastOperator      String?  @map("last_operator")
  lastOperatorId    String?  @map("last_operator_id")
  lastOperatorUser  User?    @relation("DocLastOperator", fields: [lastOperatorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  revisions InternalDocumentRevision[]
  permissions DocumentPermission[]

  @@index([folderId])
  @@index([ownerId])
  @@index([status, updatedAt])
  @@index([isPinned])
  @@index([createdById])
  @@index([lastOperatorId])
  @@map("internal_documents")
}

model InternalDocumentRevision {
  id         String           @id @default(cuid())
  documentId String           @map("document_id")
  document   InternalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title      String
  content    String?          @db.Text
  editorId   String?          @map("editor_id")
  editor     User?            @relation("DocRevisionEditor", fields: [editorId], references: [id], onDelete: SetNull)
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([documentId, createdAt])
  @@map("internal_document_revisions")
}

/** 文档权限模型（参考 Notion/Confluence 最佳实践） */
model DocumentPermission {
  id         String           @id @default(cuid())
  documentId String           @map("document_id")
  document   InternalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  /** 权限类型：viewer(查看者) | editor(编辑者) | owner(所有者，自动分配给创建者) */
  role       String           @map("role_type") // viewer | editor | owner
  
  /** 授权对象类型：user(用户) | role(角色) | public(公开) */
  targetType String           @map("target_type") // user | role | public
  
  /** 目标ID：当 targetType=user 时为 userId；当 targetType=role 时为 role slug；public 时为 null */
  targetId   String?          @map("target_id")
  
  /** 关联的用户或角色（可选，用于查询优化） */
  user       User?            @relation("DocPermissionUser", fields: [targetId], references: [id], onDelete: Cascade)
  
  /** 授予者 */
  grantedBy  String?          @map("granted_by")
  grantor    User?            @relation("DocPermissionGrantor", fields: [grantedBy], references: [id], onDelete: SetNull)
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([documentId, targetType, targetId])
  @@index([documentId])
  @@index([targetId])
  @@index([role])
  @@map("document_permissions")
}

// 文档标签注册表（owner_id 为空 = 组织标签，非空 = 个人标签）
model DocTag {
  id          String   @id @default(cuid())
  ownerId     String?  @map("owner_id")
  owner       User?    @relation("DocTagOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  createdById String?  @map("created_by_id")
  createdBy   User?    @relation("DocTagCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([ownerId, slug])
  @@index([ownerId])
  @@map("doc_tags")
}

// ═══════════════════════════════════════════
// 事务性通知发送记录（邮件等）
// ═══════════════════════════════════════════
model NotificationLog {
  id             String    @id @default(cuid())
  channel        String
  template       String
  recipient      String
  subject        String
  status         String
  error          String?
  idempotencyKey String    @unique @map("idempotency_key")
  payload        Json?
  sentAt         DateTime? @map("sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([template, createdAt])
  @@index([status, createdAt])
  @@map("notification_logs")
}

// ═══════════════════════════════════════════
// 系统设置（KV 存储）
// ═══════════════════════════════════════════
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  group     String   @default("general")
  label     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("settings")
}

// ═══════════════════════════════════════════
// 第三方集成凭证（加密存储）
// ═══════════════════════════════════════════
model Integration {
  slug        String   @id
  enabled     Boolean  @default(false)
  config      Json     @default("{}")
  secretsEnc  String?  @map("secrets_enc")
  secretsMask Json     @default("{}") @map("secrets_mask")
  updatedById String?  @map("updated_by_id")
  updatedBy   User?    @relation("IntegrationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("integrations")
}
