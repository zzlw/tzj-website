// TZJ 应急救援训练装备 — Prisma Schema
// PostgreSQL + Prisma 6

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════
// 工程案例
// ═══════════════════════════════════════════
model Case {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String?  @db.Text
  description String?  @db.Text
  coverImage  String?
  images      String[] @default([])
  location    String?
  client      String?
  caseType    String   // military | fire | police | scenic | school | enterprise
  highlights  String[] @default([])
  specs       Json?
  completionDate DateTime?
  seoTitle    String?
  seoDesc     String?
  sortOrder   Int      @default(0)
  isFeatured  Boolean  @default(false)
  status      String   @default("draft")
  scheduledAt DateTime?
  viewCount   Int      @default(0)
  author      String?
  systemPublishedAt DateTime?
  createdBy         String?
  createdById       String?
  createdByUser     User?    @relation("CaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lastOperator      String?
  lastOperatorId    String?
  lastOperatorUser  User?    @relation("CaseLastOperator", fields: [lastOperatorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([caseType])
  @@index([status])
  @@index([isFeatured])
  @@index([systemPublishedAt])
  @@index([createdById])
  @@index([lastOperatorId])
  @@map("cases")
}

// ═══════════════════════════════════════════
// 新闻资讯
// ═══════════════════════════════════════════
model News {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String?  @db.Text
  content     String?  @db.Text
  coverImage  String?
  images      String[] @default([])
  category    String   // company | industry | knowledge | equipment
  author      String?
  seoTitle    String?
  seoDesc     String?
  isTop       Boolean  @default(false)
  sortOrder   Int      @default(0)
  status      String   @default("draft")
  scheduledAt DateTime?
  viewCount   Int      @default(0)
  publishedAt DateTime?
  systemPublishedAt DateTime?
  createdBy         String?
  createdById       String?
  createdByUser     User?    @relation("NewsCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lastOperator      String?
  lastOperatorId    String?
  lastOperatorUser  User?    @relation("NewsLastOperator", fields: [lastOperatorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([publishedAt])
  @@index([systemPublishedAt])
  @@index([createdById])
  @@index([lastOperatorId])
  @@map("news")
}

// ═══════════════════════════════════════════
// 博客
// ═══════════════════════════════════════════
model Blog {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?  @db.Text
  content     String?  @db.Text
  coverImage  String?
  images      String[] @default([])
  category    String   // training_facility | burn_room | modular | practice | industry
  readTime    String?
  author      String?
  seoTitle    String?
  seoDesc     String?
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  status      String   @default("draft")
  scheduledAt DateTime?
  viewCount   Int      @default(0)
  publishedAt DateTime?
  systemPublishedAt DateTime?
  createdBy         String?
  createdById       String?
  createdByUser     User?    @relation("BlogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lastOperator      String?
  lastOperatorId    String?
  lastOperatorUser  User?    @relation("BlogLastOperator", fields: [lastOperatorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([publishedAt])
  @@index([systemPublishedAt])
  @@index([createdById])
  @@index([lastOperatorId])
  @@map("blogs")
}

// ═══════════════════════════════════════════
// 展会活动
// ═══════════════════════════════════════════
model TradeShow {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  summary        String?   @db.Text
  content        String?   @db.Text
  location       String?
  eventDateLabel String?
  startDate      DateTime?
  endDate        DateTime?
  boothNumber    String?
  eventType      String    @default("exhibition") // exhibition | seminar | roadshow | promotion
  coverImage     String?
  images         String[]  @default([])
  externalUrl    String?
  seoTitle       String?
  seoDesc        String?
  sortOrder      Int       @default(0)
  isFeatured     Boolean   @default(false)
  status         String    @default("draft")
  scheduledAt    DateTime?
  viewCount      Int       @default(0)
  publishedAt    DateTime?
  author         String?

  // ═══ 营销弹窗（docs/activity-system-design.md；均带默认值，零破坏性）═══
  isMarketing     Boolean  @default(false) // 总开关；展示窗口复用 startDate/endDate
  triggerMode     String   @default("immediate") // immediate | delay | scroll
  delaySeconds    Int      @default(3) // triggerMode=delay 时生效，1~60
  frequency       String   @default("session") // session | daily | once
  excludePages    String[] @default([]) // 不展示的路径（不含 locale 前缀），如 ["/products"]
  targetDevice    String   @default("all") // all | mobile | desktop
  ctaText         String   @default("立即参与") // CTA 按钮文字
  popupImage      String? // 弹窗专用头图；留空回退 coverImage（封面图仅服务列表/详情页）
  popupContent    String?  @db.Text // 弹窗专用文案（Markdown）；留空回退 content（详情正文不再与弹窗共用）
  ctaUrl          String? // 已废弃（2026-07）：弹窗 CTA 改走 externalUrl；列保留避免破坏性迁移
  popupViewCount  Int      @default(0) // 弹窗曝光量（与详情页 viewCount 分开）
  popupClickCount Int      @default(0) // CTA 点击量
  systemPublishedAt DateTime?
  createdBy         String?
  createdById       String?
  createdByUser     User?    @relation("TradeShowCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lastOperator      String?
  lastOperatorId    String?
  lastOperatorUser  User?    @relation("TradeShowLastOperator", fields: [lastOperatorId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([eventType])
  @@index([status])
  @@index([startDate])
  @@index([isMarketing])
  @@index([systemPublishedAt])
  @@index([createdById])
  @@index([lastOperatorId])
  @@map("trade_shows")
}

// ═══════════════════════════════════════════
// 联系信息
// ═══════════════════════════════════════════
model Contact {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  company   String?
  subject   String?
  message   String   @db.Text
  source    String?  // website | admin | api
  // 提交时携带的持久匿名访客 ID（_tzj_vid，与埋点同源）：把询盘直接锚定到浏览轨迹，
  // 无需依赖 identify 的 email/userId 拼接，转线索后供客户列表反查访客抽屉。
  visitorId String?
  isRead    Boolean  @default(false)
  isHandled Boolean  @default(false)
  remark    String?  @db.Text
  lastOperator      String?
  lastOperatorId    String?
  lastOperatorUser  User?    @relation("ContactLastOperator", fields: [lastOperatorId], references: [id], onDelete: SetNull)
  // 软删除标记：回收站 30 天后由清理任务物理删除（见 docs/design/deletion-strategy.md）
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead])
  @@index([isHandled])
  @@index([createdAt])
  @@index([lastOperatorId])
  @@index([visitorId])
  @@index([deletedAt])
  @@map("contacts")
}

// ═══════════════════════════════════════════
// 静态页面（关于我们、服务承诺等）
// ═══════════════════════════════════════════
model Page {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String?  @db.Text
  coverImage String?
  seoTitle  String?
  seoDesc   String?
  status    String   @default("published")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pages")
}

// ═══════════════════════════════════════════
// 用户（管理后台）
// ═══════════════════════════════════════════
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  nickname  String?
  email     String?  @unique
  phone     String?  @unique
  avatar    String?
  role      String   @default("editor") // admin | editor | viewer
  isActive  Boolean  @default(true)
  lastLoginAt DateTime?
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  // ── 2FA（TOTP）：全部可空/带默认值，向后兼容无破坏性迁移 ──
  twoFactorEnabled          Boolean   @default(false) // 是否已启用 2FA
  twoFactorSecretEnc        String?                   // AES-256-GCM 加密后的 TOTP Secret（启用后才写入）
  twoFactorPendingSecretEnc String?                   // 绑定流程中的待确认 Secret（加密），确认或超时后清空
  twoFactorPendingCreatedAt DateTime?                 // 待确认 Secret 生成时间（15 分钟过期）
  twoFactorConfirmedAt      DateTime?                 // 启用时间（审计/展示用）
  twoFactorLastStep         BigInt?                   // 最近一次成功校验的 TOTP 绝对时间步（重放防护；BigInt 规避 Int32 溢出）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions    Session[]
  auditLogs   AuditLog[]
  recoveryCodes TwoFactorRecoveryCode[]
  mediaAssets MediaAsset[]
  casesLastOperated     Case[]      @relation("CaseLastOperator")
  newsLastOperated      News[]      @relation("NewsLastOperator")
  blogsLastOperated     Blog[]      @relation("BlogLastOperator")
  tradeShowsLastOperated TradeShow[] @relation("TradeShowLastOperator")
  casesCreated          Case[]      @relation("CaseCreatedBy")
  newsCreated           News[]      @relation("NewsCreatedBy")
  blogsCreated          Blog[]      @relation("BlogCreatedBy")
  tradeShowsCreated     TradeShow[] @relation("TradeShowCreatedBy")
  contactsLastOperated  Contact[]   @relation("ContactLastOperator")
  customersOwned        Customer[]  @relation("CustomerOwner")
  customersLastOperated Customer[]  @relation("CustomerLastOperator")
  customersCreated      Customer[]  @relation("CustomerCreatedBy")
  blockedIpsCreated     BlockedIp[] @relation("BlockedIpCreatedBy")
  integrationsUpdated Integration[] @relation("IntegrationUpdatedBy")
  docsCreated           InternalDocument[] @relation("DocCreatedBy")
  docsLastOperated      InternalDocument[] @relation("DocLastOperator")
  docRevisionsEdited    InternalDocumentRevision[] @relation("DocRevisionEditor")
  docFoldersOwned       DocFolder[] @relation("DocFolderOwner")
  personalDocuments     InternalDocument[] @relation("DocPersonalOwner")
  docTagsOwned          DocTag[] @relation("DocTagOwner")
  docTagsCreated        DocTag[] @relation("DocTagCreatedBy")
  docPermissionsGranted DocumentPermission[] @relation("DocPermissionGrantor")
  docPermissionsAsUser  DocumentPermission[] @relation("DocPermissionUser")
  lingxiConversations   LingxiConversation[]

  @@map("users")
}

// ═══════════════════════════════════════════
// 2FA 恢复码（一次一密，不存明文）
// ═══════════════════════════════════════════
model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String                    // SHA-256(codeSalt ‖ 规范化恢复码)，不存明文
  codeSalt  String                    // 每码独立 salt（CSPRNG），与 codeHash 同记录
  usedAt    DateTime?                 // 使用即标记，永不复用
  createdAt DateTime  @default(now())

  // 加盐后无法按 hash 反查（验证时逐条带 salt 比对），仅按用户索引
  @@index([userId])
  @@map("two_factor_recovery_codes")
}

// ═══════════════════════════════════════════
// 角色与权限（RBAC）
// ═══════════════════════════════════════════
model AccessRole {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("access_roles")
}

// ═══════════════════════════════════════════
// 媒体库（图片/视频/文档统一管理）
// ═══════════════════════════════════════════
model MediaAsset {
  id           String    @id @default(cuid())
  key          String    @unique // S3 对象 key
  url          String // 公开访问 URL
  filename     String // 原始文件名
  mimeType     String
  size         Int // 字节
  width        Int?
  height       Int?
  folder       String    @default("uploads")
  alt          String?
  // 水印烧录状态：true=服务端已烧录；false=服务端经手但确认未烧录；null=未知（历史数据/直传登记/替换链路）
  watermarked  Boolean?
  // 水印参数快照（烧录时的渲染配置 + 时刻）与配置指纹：配合指纹识别旧参数素材，为批量重烧打基础
  watermarkParams     Json?
  watermarkFingerprint String?
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([folder])
  @@index([mimeType])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("media_assets")
}

// ═══════════════════════════════════════════
// 登录会话（refresh token 轮换 / 可撤销）
// ═══════════════════════════════════════════
model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique // refresh token 的 sha256，不存明文
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  // 轮换宽限期（OAuth 2.0 安全 BCP / Auth0 最佳实践）：
  // 轮换时记录继任会话 + 宽限截止时间，窗口内的「并发竞态复用」返回继任令牌，
  // 而非误判为令牌盗用撤销全部会话（解决坐席被频繁强制登出的问题）。
  rotatedToHash String?
  graceUntil    DateTime?
  // 2FA gating：本会话通过 2FA 验证的时间；twoFactorEnabled 用户的会话若为 null，refresh 时拒绝（堵 refresh 绕过 2FA）
  twoFactorVerifiedAt DateTime?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ═══════════════════════════════════════════
// 审计日志（谁在何时对什么做了什么）
// ═══════════════════════════════════════════
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // login | logout | create | update | delete | publish ...
  resource   String   // product | case | news | user ...
  resourceId String?
  detail     Json?
  ip         String?
  userAgent  String?
  traceId    String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════
// 官网访客分析（PageView 事件）
// ═══════════════════════════════════════════
model PageView {
  id           String   @id @default(cuid())
  // 持久匿名访客 ID（localStorage，跨会话归并同一浏览器访客）
  visitorId    String?
  // 单次会话 ID（sessionStorage，按会话聚合）
  sessionId    String
  // 已识别身份 ID（提交询盘/登录后回写，用于跨设备归并）
  userId       String?
  path         String
  title        String?
  referrer     String?
  referrerHost String?
  userAgent    String?
  ipHash       String?
  ip           String?
  ipMasked     String?
  country      String?
  region       String?
  city         String?
  geoSource    String?
  deviceType   String?
  deviceModel  String?
  deviceVendor String?
  browser      String?
  browserVersion String?
  os           String?
  osVersion    String?
  // 内嵌浏览器宿主 App（微信/抖音/微博…），独立浏览器为 null
  clientApp    String?
  // 营销归因（会话首触）：UTM 五参数 + 广告点击 ID（Google gclid / 百度 OCPC bd_vid）
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  gclid        String?
  bdVid        String?
  // 服务端计算的渠道分组：direct/organic/paid/social/email/referral/other
  trafficSource String?
  isBot        Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([sessionId])
  @@index([visitorId])
  @@index([userId])
  @@index([referrerHost, createdAt])
  @@index([isBot, createdAt])
  @@index([country, createdAt])
  @@index([ipHash, createdAt])
  @@index([trafficSource, createdAt])
  @@index([utmCampaign, createdAt])
  @@map("page_views")
}

// ═══════════════════════════════════════════
// 访客身份（identify 升级：匿名 → 已知）
// 同一 visitorId 的多次会话在 B 端的「访客会话」中归并为一行
// ═══════════════════════════════════════════
model Visitor {
  id           String    @id @default(cuid())
  // 与 PageView.visitorId 对应（持久匿名 ID）
  anonymousId  String    @unique
  // 已识别身份（如询盘 ID / 登录用户 ID），用于跨设备归并
  userId       String?
  email        String?
  name         String?
  phone        String?
  company      String?
  // 额外画像（如来源页、UTM 等）
  traits       Json?
  firstSeenAt  DateTime  @default(now())
  lastSeenAt   DateTime  @updatedAt
  // 首次识别时间（提交询盘/identify 时写入）
  identifiedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([email])
  @@index([identifiedAt])
  @@map("visitors")
}

// ═══════════════════════════════════════════
// 访客 IP 封禁（哈希存储，支持临时封禁）
// ═══════════════════════════════════════════
model BlockedIp {
  id          String    @id @default(cuid())
  ipHash      String    @unique
  ipMasked    String
  reason      String?
  expiresAt   DateTime?
  createdById String?
  createdBy   User?     @relation("BlockedIpCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([expiresAt])
  @@map("blocked_ips")
}

// ═══════════════════════════════════════════
// 内部文档库（仅后台，不对 C 端公开）
// ═══════════════════════════════════════════
model DocFolder {
  id        String      @id @default(cuid())
  ownerId   String?     @map("owner_id")
  owner     User?       @relation("DocFolderOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  parentId  String?     @map("parent_id")
  parent    DocFolder?  @relation("DocFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  DocFolder[] @relation("DocFolderTree")
  name      String
  slug      String
  sortOrder Int         @default(0) @map("sort_order")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  documents InternalDocument[]

  @@unique([ownerId, parentId, slug])
  @@index([sortOrder])
  @@index([ownerId])
  @@map("doc_folders")
}

model InternalDocument {
  id          String     @id @default(cuid())
  ownerId     String?    @map("owner_id")
  owner       User?      @relation("DocPersonalOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  folderId    String?    @map("folder_id")
  folder      DocFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  title       String
  slug        String     @unique
  summary     String?    @db.Text
  content     String?    @db.Text
  status      String     @default("draft")
  tags        String[]   @default([])
  isPinned    Boolean    @default(false) @map("is_pinned")
  sortOrder   Int        @default(0) @map("sort_order")
  viewCount   Int        @default(0) @map("view_count")
  publishedAt DateTime?  @map("published_at")
  createdBy         String?  @map("created_by")
  createdById       String?  @map("created_by_id")
  createdByUser     User?    @relation("DocCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lastOperator      String?  @map("last_operator")
  lastOperatorId    String?  @map("last_operator_id")
  lastOperatorUser  User?    @relation("DocLastOperator", fields: [lastOperatorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  revisions InternalDocumentRevision[]
  permissions DocumentPermission[]

  @@index([folderId])
  @@index([folderId, sortOrder])
  @@index([ownerId])
  @@index([status, updatedAt])
  @@index([isPinned])
  @@index([createdById])
  @@index([lastOperatorId])
  @@map("internal_documents")
}

model InternalDocumentRevision {
  id         String           @id @default(cuid())
  documentId String           @map("document_id")
  document   InternalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title      String
  content    String?          @db.Text
  editorId   String?          @map("editor_id")
  editor     User?            @relation("DocRevisionEditor", fields: [editorId], references: [id], onDelete: SetNull)
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([documentId, createdAt])
  @@map("internal_document_revisions")
}

/** 文档权限模型（参考 Notion/Confluence 最佳实践） */
model DocumentPermission {
  id         String           @id @default(cuid())
  documentId String           @map("document_id")
  document   InternalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  /** 权限类型：viewer(查看者) | editor(编辑者) | owner(所有者，自动分配给创建者) */
  role       String           @map("role_type") // viewer | editor | owner
  
  /** 授权对象类型：user(用户) | role(角色) | public(公开) */
  targetType String           @map("target_type") // user | role | public
  
  /** 目标ID：当 targetType=user 时为 userId；当 targetType=role 时为 role slug；public 时为 null */
  targetId   String?          @map("target_id")
  
  /** 关联的用户或角色（可选，用于查询优化） */
  user       User?            @relation("DocPermissionUser", fields: [targetId], references: [id], onDelete: Cascade)
  
  /** 授予者 */
  grantedBy  String?          @map("granted_by")
  grantor    User?            @relation("DocPermissionGrantor", fields: [grantedBy], references: [id], onDelete: SetNull)
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([documentId, targetType, targetId])
  @@index([documentId])
  @@index([targetId])
  @@index([role])
  @@map("document_permissions")
}

// 文档标签注册表（owner_id 为空 = 组织标签，非空 = 个人标签）
model DocTag {
  id          String   @id @default(cuid())
  ownerId     String?  @map("owner_id")
  owner       User?    @relation("DocTagOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  createdById String?  @map("created_by_id")
  createdBy   User?    @relation("DocTagCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([ownerId, slug])
  @@index([ownerId])
  @@map("doc_tags")
}

// ═══════════════════════════════════════════
// 事务性通知发送记录（邮件等）
// ═══════════════════════════════════════════
model NotificationLog {
  id             String    @id @default(cuid())
  channel        String
  template       String
  recipient      String
  subject        String
  status         String
  error          String?
  idempotencyKey String    @unique @map("idempotency_key")
  payload        Json?
  sentAt         DateTime? @map("sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([template, createdAt])
  @@index([status, createdAt])
  @@map("notification_logs")
}

// ═══════════════════════════════════════════
// 系统设置（KV 存储）
// ═══════════════════════════════════════════
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  group     String   @default("general")
  label     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("settings")
}

// ═══════════════════════════════════════════
// 第三方集成凭证（加密存储）
// ═══════════════════════════════════════════
model Integration {
  slug        String   @id
  enabled     Boolean  @default(false)
  config      Json     @default("{}")
  secretsEnc  String?  @map("secrets_enc")
  secretsMask Json     @default("{}") @map("secrets_mask")
  updatedById String?  @map("updated_by_id")
  updatedBy   User?    @relation("IntegrationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("integrations")
}

// ═══════════════════════════════════════════
// 客户管理（私海 / 公海线索池）
// ═══════════════════════════════════════════
// 私海 / 公海模型（业内 CRM 最佳实践）：
//  - ownerId 为空 → 公海（未分配，任意坐席可认领）
//  - ownerId 指向某坐席 → 私海（该坐席的「我的客户」）
//  - 通过 claim / release / transfer 在公海与私海、坐席之间流转
model Customer {
  id          String   @id @default(cuid())
  name        String // 联系人姓名
  company     String? // 客户单位
  title       String? // 联系人职务
  phone       String?
  email       String?
  // 客户类型（对齐业务：应急救援训练装备的客群）
  customerType String  @default("other") // fire|armed-police|military|scenic|school|enterprise|government|other
  source      String? // website|exhibition|referral|cold-call|existing|other
  level       String   @default("C") // A(重点)|B(普通)|C(潜在)
  stage       String   @default("new") // new|following|intent|deal|lost
  amount      Int? // 预估金额（元）
  region      String?
  address     String?
  tags        String[] @default([])
  notes       String?  @db.Text
  chatRoomId  String?  @unique // 来源会话 roomId（幂等去重 + 溯源）
  contactId   String?  @unique // 来源询盘 ID（询盘转线索，幂等去重 + 溯源）
  visitorId   String? // 来源匿名访客 ID（_tzj_vid，转化时直接锚定；访客列表/IP 归因首选）

  // 归属：空 = 公海；指向坐席 = 私海
  ownerId           String?
  owner             User?    @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  lastContactAt     DateTime?
  nextFollowAt      DateTime?

  lastOperator      String?
  lastOperatorId    String?
  lastOperatorUser  User?    @relation("CustomerLastOperator", fields: [lastOperatorId], references: [id], onDelete: SetNull)
  createdBy         String?
  createdById       String?
  createdByUser     User?    @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // 软删除标记：软删时同步置空 contactId/chatRoomId 唯一锚点（原值入审计快照）
  deletedAt         DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
  @@index([stage])
  @@index([level])
  @@index([source])
  @@index([customerType])
  @@index([createdAt])
  @@index([lastContactAt])
  @@index([chatRoomId])
  @@index([contactId])
  @@index([visitorId])
  @@index([deletedAt])
  @@map("customers")
}

// ═══════════════════════════════════════════
// 在线客服 — 聊天室
// ═══════════════════════════════════════════
model ChatRoom {
  id                   String        @id @default(cuid())
  roomId               String        @unique
  clientEmail          String
  clientName           String?
  status               String        @default("waiting")
  assignedAgentEmail   String?
  lastActivity         DateTime      @default(now())
  closedAt             DateTime?
  closedBy             String?
  tags                 String[]      @default([])
  notes                String?
  unreadCountForClient Int           @default(0)
  unreadCountForAgent  Int           @default(0)
  lastReadByClient     DateTime?
  lastReadByAgent      DateTime?
  // 自动归档：closed 超过保留期后由定时任务置为 archived（仍可在「已关闭」桶检索）
  archivedAt           DateTime?
  // 软删除：批量删除仅打标，列表查询过滤；物理删除走独立清理任务
  deletedAt            DateTime?
  // 关联客户：坐席在会话中将访客转为客户线索后写入
  customerId           String?
  // 关联分析访客（Visitor.anonymousId / _tzj_vid），供 B 端按人查聊天历史
  visitorId            String?

  // ── 访客画像（创建会话时由服务端 enrichment，字段对齐 PageView 模型）──
  // 原始 IP 仅服务端持有，不向 C 端下发；B 端仅展示脱敏后的 ipMasked。
  clientIp     String?
  ipMasked     String?
  country      String?
  region       String?
  city         String?
  deviceType   String?
  deviceModel  String?
  deviceVendor String?
  browser      String?
  browserVersion String?
  os           String?
  osVersion    String?
  // 内嵌浏览器宿主 App（微信/抖音/微博…），独立浏览器为 null
  clientApp    String?
  referrer     String?
  referrerHost String?
  userAgent    String?
  landingPath  String?
  source       String? // UTM source / 渠道来源

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  messages             ChatMessage[]

  @@index([status, lastActivity]) // 列表按 (status, lastActivity) 游标分页
  @@index([deletedAt])
  @@index([archivedAt])
  @@index([customerId])
  @@index([visitorId])
  @@map("chat_rooms")
}

model ChatMessage {
  id          String               @id @default(cuid())
  messageId   String               @unique
  content     String? // 允许仅含附件、无文本内容的消息
  sender      String
  senderEmail String?
  timestamp   DateTime             @default(now())
  isRead      Boolean              @default(false)

  chatRoomId  String
  room        ChatRoom             @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)

  readReceipts MessageReadReceipt[]
  attachments  ChatAttachment[]

  @@index([chatRoomId])
  // pg_trgm GIN 索引：加速 content 的 ILIKE 子串检索与 similarity() 相关度排序（坐席端聊天正文搜索）。
  // 依赖 pg_trgm 扩展（见 0_init 迁移中的 CREATE EXTENSION）；map 保持既有索引名以兼容历史库。
  @@index([content(ops: raw("gin_trgm_ops"))], type: Gin, map: "chat_messages_content_trgm_idx")
  @@map("chat_messages")
}

/// 聊天消息附件（归一化存储，便于生命周期清理与元数据展示）
model ChatAttachment {
  id          String      @id @default(cuid())
  message     ChatMessage @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  chatMessageId String

  key         String // S3/OSS 对象 key，如 chat/202607/ROOM-XXX/uuid-name.png
  fileName    String
  contentType String
  size        Int

  createdAt   DateTime    @default(now())

  @@index([chatMessageId])
  @@map("chat_attachments")
}

/// 预签名上传占位：用户拿 URL 直传后、消息尚未发出前的临时记录。
/// 用于：① 发送时把元数据落库为 ChatAttachment；② 定时清理回收「上传了但未发送」的孤儿文件。
model ChatPendingUpload {
  id          String   @id @default(cuid())
  roomId      String
  senderEmail String
  key         String   @unique
  fileName    String
  contentType String
  size        Int
  expiresAt   DateTime // 过期后由定时任务回收对应 S3 对象
  createdAt   DateTime @default(now())

  @@index([expiresAt])
  @@map("chat_pending_uploads")
}

model MessageReadReceipt {
  id        String      @id @default(cuid())
  userEmail String
  userType  String
  readAt    DateTime    @default(now())

  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_read_receipts")
}

// ═══════════════════════════════════════════
// 灵犀 AI 投放报告 — 会话与消息
// ═══════════════════════════════════════════

/// 灵犀会话：按用户隔离，软删（deletedAt）+ 回收站 30 天后物理清除（级联删消息）。
model LingxiConversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messages LingxiMessage[]

  @@index([userId, updatedAt])
  @@index([deletedAt])
  @@map("lingxi_conversations")
}

/// 灵犀消息：role = user | assistant | tool；meta 存工具调用/数据引用等结构化信息。
model LingxiMessage {
  id             String             @id @default(cuid())
  conversationId String
  conversation   LingxiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String             @db.Text
  meta           Json?
  createdAt      DateTime           @default(now())

  @@index([conversationId, createdAt])
  @@map("lingxi_messages")
}

// ═══════════════════════════════════════════
// 广告花费台账（分平台分时段；手工录入 + 未来 API 同步共用）
// docs/ad-spend-ledger-design.md
// ═══════════════════════════════════════════
model AdSpendRecord {
  id          String   @id @default(cuid())
  // 平台标识：baidu / google / wechat / other（应用层常量约束，不用 DB enum 便于扩平台）
  platform    String
  // 记账区间（日历日，无时区语义，含首尾；运算口径见设计文档 §3「时间口径」）；单日记录 periodStart == periodEnd
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  // 金额（元，两位小数）
  spend       Decimal  @db.Decimal(12, 2)
  // 来源：manual（手工）/ baidu_api（升级 2 预留）
  source      String   @default("manual")
  note        String?
  createdBy   String? // 操作人 userId（API 同步为 null）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([platform, periodStart])
  @@index([periodStart, periodEnd])
  @@map("ad_spend_records")
}
