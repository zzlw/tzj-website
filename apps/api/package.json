{
  "name": "@tzj/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "biome lint src/",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "node --env-file=../../.env ./node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate dev",
    "prisma:migrate:deploy": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate deploy",
    "prisma:baseline": "bash ./scripts/baseline-migrations.sh",
    "prisma:push": "node --env-file=../../.env ./node_modules/prisma/build/index.js db push",
    "prisma:studio": "node --env-file=../../.env ./node_modules/prisma/build/index.js studio",
    "prisma:seed": "node --env-file=../../.env ./node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "prisma:index:search": "node --env-file=../../.env ./node_modules/tsx/dist/cli.mjs prisma/apply-search-indexes.ts",
    "prisma:seed:content": "node --env-file=../../.env ./node_modules/tsx/dist/cli.mjs prisma/seed-content.ts",
    "prisma:seed:content:media": "node --env-file=../../.env ./node_modules/tsx/dist/cli.mjs prisma/seed-content-media.ts",
    "seed:contacts:mock": "node --env-file=../../.env ./node_modules/tsx/dist/cli.mjs scripts/seed-contacts-mock.ts",
    "seed:visitors:mock": "node --env-file=../../.env ./node_modules/tsx/dist/cli.mjs scripts/seed-visitors-mock.ts",
    "seed:chat:mock": "node --env-file=../../.env ./node_modules/tsx/dist/cli.mjs scripts/seed-chat-mock.ts",
    "seed:customers:mock": "node --env-file=../../.env ./node_modules/tsx/dist/cli.mjs scripts/seed-customers-mock.ts",
    "seed:analytics:mock": "node --env-file=../../.env ./node_modules/tsx/dist/cli.mjs scripts/seed-analytics-mock.ts",
    "seed:legal-pages": "node --env-file=../../.env ./node_modules/tsx/dist/cli.mjs scripts/seed-legal-pages.ts",
    "seed:roles": "node --env-file=../../.env ./node_modules/tsx/dist/cli.mjs scripts/seed-roles.ts",
    "sync:system-analysis": "node --env-file=../../.env ./node_modules/tsx/dist/cli.mjs scripts/sync-system-analysis.ts",
    "sync:security-runbook": "node --env-file=../../.env ./node_modules/tsx/dist/cli.mjs scripts/sync-security-runbook.ts",
    "prisma:sync:static-media": "node --env-file=../../.env ./node_modules/tsx/dist/cli.mjs prisma/seed-content-media.ts",
    "test:favicon": "node --env-file=../../.env ./node_modules/tsx/dist/cli.mjs scripts/test-favicon.ts"
  },
  "dependencies": {
    "@alicloud/captcha20230305": "^1.1.4",
    "@alicloud/dm20151123": "^1.10.2",
    "@alicloud/openapi-core": "^1.0.7",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.28",
    "@prisma/client": "^6.19.3",
    "@tzj/types": "workspace:*",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "geoip-lite": "^1.4.10",
    "helmet": "^8.2.0",
    "lib-qqwry": "^1.3.4",
    "openai": "^7.1.0",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "png-to-ico": "^3.0.2",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.5",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.27",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/geoip-lite": "^1.4.4",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.1",
    "jest": "^30.4.2",
    "node-gyp": "^11.0.0",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
