{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "TZJ NestJS TSConfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "noEmit": false,
    "outDir": "./dist",
    "declaration": true,
    "removeComments": true
  }
}
