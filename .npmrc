registry=https://registry.npmmirror.com
shamefully-hoist=true
strict-peer-dependencies=false
auto-install-peers=true
onlyBuiltDependencies[]="@prisma/client"
onlyBuiltDependencies[]="@prisma/engines"
onlyBuiltDependencies[]="prisma"
onlyBuiltDependencies[]="esbuild"
onlyBuiltDependencies[]="sharp"
onlyBuiltDependencies[]="bcrypt"
onlyBuiltDependencies[]="@parcel/watcher"
onlyBuiltDependencies[]="@swc/core"
onlyBuiltDependencies[]="@alicloud/openapi-core"
onlyBuiltDependencies[]="@scarf/scarf"
# 禁止 pnpm run 前的依赖状态检查自动 install：Docker builder 阶段 workspace importer 与 node_modules 不一致时
# 会触发自动 install 并执行 bcrypt 等原生模块编译（alpine 无工具链直接失败），本地一致性由手动 install 保证
verify-deps-before-run=false
